rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOffice() {
      return signedIn() && (myUser().role == 'office' || myUser().isAdmin == true);
    }

    function isActive() {
      return signedIn() && myUser().active == true;
    }

    function isMaster() {
      return signedIn() && myUser().isAdmin == true;
    }

    function validWebBooking() {
      return request.resource.data.keys().hasAll(['name', 'phone', 'service', 'area', 'message', 'preferredDate', 'preferredTime', 'status', 'source', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'phone', 'service', 'area', 'message', 'preferredDate', 'preferredTime', 'status', 'source', 'createdAt'])
        && request.resource.data.name.matches('(?s).*') && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 120
        && request.resource.data.phone.matches('(?s).*') && request.resource.data.phone.size() >= 9 && request.resource.data.phone.size() <= 20
        && request.resource.data.service.matches('(?s).*') && request.resource.data.service.size() >= 2 && request.resource.data.service.size() <= 120
        && request.resource.data.area.matches('(?s).*') && request.resource.data.area.size() >= 2 && request.resource.data.area.size() <= 120
        && request.resource.data.message.matches('(?s).*') && request.resource.data.message.size() <= 2000
        && request.resource.data.preferredDate.matches('(?s).*') && request.resource.data.preferredDate.size() <= 10
        && request.resource.data.preferredTime.matches('(?s).*') && request.resource.data.preferredTime.size() <= 5
        && request.resource.data.status == 'pending'
        && request.resource.data.source == 'website'
        && request.resource.data.createdAt == request.time;
    }

    match /settings/public {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/settings/public);
      allow update, delete: if isOffice();
    }

    function bootstrapEra() {
      return !exists(/databases/$(database)/documents/settings/public)
        || !get(/databases/$(database)/documents/settings/public).data.initialized;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if !signedIn() || isOffice()
        || (request.auth.uid == uid && request.resource.data.isAdmin != true)
        || (request.auth.uid == uid && bootstrapEra());
      allow update: if isMaster()
        || (isOffice()
            && request.resource.data.role == resource.data.role
            && request.resource.data.isAdmin == resource.data.isAdmin
            && request.resource.data.validUntil == resource.data.validUntil);
      allow delete: if isMaster();
    }

    match /jobs/{jobId} {
      allow read: if isOffice() || (isActive() && resource.data.assignedTo == request.auth.uid);

      allow create: if isOffice();

      allow update: if isOffice()
        || (isActive()
            && resource.data.assignedTo == request.auth.uid
            && request.resource.data.assignedTo == resource.data.assignedTo
            && request.resource.data.technicianName == resource.data.technicianName
            && request.resource.data.assignedByName == resource.data.assignedByName);

      allow delete: if isOffice();
    }

    match /invoices/{invoiceId} {
      allow read: if isOffice() || (isActive() && resource.data.assignedTo == request.auth.uid);
      allow create: if isOffice();
      allow update: if isOffice();
      allow delete: if isOffice();
    }

    match /webBookings/{bookingId} {
      allow read: if isOffice();
      allow create: if validWebBooking();
      allow update: if isOffice();
      allow delete: if isOffice();
    }

    match /counters/{docId} {
      allow read, write: if signedIn();
    }
  }
}