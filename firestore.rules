rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOffice() {
      return signedIn() && (myUser().role == 'office' || myUser().isAdmin == true);
    }

    function isActive() {
      return signedIn() && myUser().active == true;
    }

    function isMaster() {
      return signedIn() && myUser().isAdmin == true;
    }

    function validWebBooking() {
      return request.resource.data.keys().hasAll(['name', 'phone', 'service', 'area', 'message', 'preferredDate', 'preferredTime', 'status', 'source', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'phone', 'service', 'area', 'message', 'preferredDate', 'preferredTime', 'status', 'source', 'createdAt'])
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('phone', '') is string
        && request.resource.data.get('service', '') is string
        && request.resource.data.get('area', '') is string
        && request.resource.data.get('message', '') is string
        && request.resource.data.get('preferredDate', '') is string
        && request.resource.data.get('preferredTime', '') is string
        && request.resource.data.get('status', '') == 'pending'
        && (request.resource.data.get('source', '') == 'website' || request.resource.data.get('source', '') == 'zaza' || request.resource.data.get('source', '') == 'mozaz')
        && request.resource.data.createdAt == request.time;
    }

    match /settings/public {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/settings/public);
      allow update: if isMaster();
      allow delete: if false;
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow create, update: if isMaster();
      allow delete: if false;
    }

    function bootstrapEra() {
      return !exists(/databases/$(database)/documents/settings/public)
        || !get(/databases/$(database)/documents/settings/public).data.initialized;
    }

    match /users/{uid} {
      allow read: if signedIn() && (!resource.data.get('isAdmin', false) || isMaster());
      allow create: if isMaster()
        || (signedIn() && request.auth.uid == uid && bootstrapEra());
      allow update: if isMaster();
      allow delete: if isMaster();
    }

    match /jobs/{jobId} {
      allow read: if isOffice() || (isActive() && resource.data.assignedTo == request.auth.uid);

      allow create: if isOffice();

      allow update: if isOffice()
        || (isActive()
            && resource.data.assignedTo == request.auth.uid
            && request.resource.data.assignedTo == resource.data.assignedTo
            && request.resource.data.technicianName == resource.data.technicianName
            && request.resource.data.assignedByName == resource.data.assignedByName);

      allow delete: if isMaster();
    }

    match /invoices/{invoiceId} {
      allow read: if isOffice() || (isActive() && resource.data.assignedTo == request.auth.uid);
      allow create: if isOffice();
      allow update: if isOffice();
      allow delete: if isMaster();
    }

    match /webBookings/{bookingId} {
      allow read: if isOffice();
      allow create: if validWebBooking();
      allow update: if isMaster() || (isOffice() && !resource.data.get('temporarilyDeleted', false));
      allow delete: if isMaster();
    }

    match /counters/{docId} {
      allow read, write: if signedIn();
    }
  }
}